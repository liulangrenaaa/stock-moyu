{
  "name": "stock-moyu",
  "displayName": "股票摸鱼 · Stock Moyu",
  "description": "通过快捷键悬浮查看自选股票行情，状态栏保留精简摘要。",
  "version": "0.2.0",
  "publisher": "liulangrenaaa",
  "license": "UNLICENSED",
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "股票",
    "行情",
    "stock"
  ],
  "main": "./extension.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/liulangrenaaa/stock-moyu.git"
  },
  "bugs": {
    "url": "https://github.com/liulangrenaaa/stock-moyu/issues"
  },
  "contributes": {
    "commands": [
      {
        "command": "stockMoyu.start",
        "title": "开启行情",
        "category": "Stock Moyu"
      },
      {
        "command": "stockMoyu.stop",
        "title": "停止行情",
        "category": "Stock Moyu"
      },
      {
        "command": "stockMoyu.togglePopup",
        "title": "切换悬浮行情",
        "category": "Stock Moyu"
      },
      {
        "command": "stockMoyu.configure",
        "title": "编辑自选股票",
        "category": "Stock Moyu"
      }
    ],
    "keybindings": [
      {
        "command": "stockMoyu.togglePopup",
        "key": "ctrl+alt+s",
        "mac": "cmd+ctrl+s"
      }
    ],
    "configurationDefaults": {
      "terminal.integrated.commandsToSkipShell": [
        "stockMoyu.togglePopup"
      ]
    },
    "menus": {
      "editor/context": [
        {
          "command": "stockMoyu.start",
          "group": "navigation@100"
        }
      ]
    },
    "configuration": {
      "title": "Stock Moyu 股票摸鱼",
      "properties": {
        "stockMoyu.stockCodes": {
          "type": "array",
          "default": [
            "sh000001",
            "sz002649"
          ],
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(sh|sz|bj)[0-9]{6}$"
          },
          "description": "股票或指数代码，支持 sh、sz、bj 前缀。"
        },
        "stockMoyu.updateInterval": {
          "type": "integer",
          "default": 3000,
          "minimum": 1000,
          "maximum": 3600000,
          "description": "交易时段每次请求完成后的刷新间隔，单位毫秒；非交易时段降频，临近开盘恢复，失败时自动退避。时段按北京时间工作日判断，未接入节假日日历。"
        },
        "stockMoyu.statusBarMaxStocks": {
          "type": "integer",
          "default": 2,
          "minimum": 1,
          "maximum": 10,
          "description": "状态栏最多显示的股票数量，其余通过悬浮行情查看。"
        }
      }
    }
  },
  "scripts": {
    "check": "node --check extension.js && node --check getStock.js && node --check refreshPolicy.js && node --check quotePopup.js",
    "test": "node --test",
    "package": "vsce package --skip-license"
  },
  "devDependencies": {
    "@vscode/vsce": "4.1.1"
  }
}
